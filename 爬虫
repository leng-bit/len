#爬虫
import requests
from lxml import etree
import time
import random as r

ur1 = "https://www.bing.com/search?q=%E7%BB%B4%E5%9F%BA%E7%99%BE%E7%A7%91&form=ANNTH1&refig=69d4b2bc329a4bb2b9e3bcf18ed5f852&pc=WSEDDB&adppc=EDGEDBB"
ur2 = "https://zh.wikipedia.org/wiki/%E5%8D%8E%E7%89%B9%E8%BF%AA%E5%A3%AB%E5%B0%BC%E5%85%AC%E5%8F%B8"
UA = ["Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36 Edg/146.0.0.0",
      "mozilla/5.0 (windows nt 10.0; win64; x64) applewebkit/537.36 (khtml, like gecko) chrome/125.0.0.0 safari/537.36",
      "mozilla/5.0 (windows nt 10.0; win64; x64) applewebkit/537.36 (khtml, like gecko) chrome/124.0.0.0 safari/537.36"]
headers = {
    "User-Agent":r.choice(UA),
    "Referer":ur1
}
response = requests.get(ur2, headers=headers)
time.sleep(r.uniform(1,3))
response.raise_for_status()

lxml = response.text
tree = etree.HTML(lxml)
content = tree.xpath("//div[@id='mw-content-text']//li//text()")
content = "".join(content).strip()
print(content)
